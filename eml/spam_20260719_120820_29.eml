            font-weight: 600;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 14px;
            margin-top: 10px;
        }
        =20
        .info-box {
            background-color: #fdf0f5;
            border-left: 5px solid #e91e8c;
            padding: 16px 20px;
            margin-bottom: 22px;
            border-radius: 0 6px 6px 0;
        }
        .info-box .label {
            font-weight: 700;
        }
        .info-box .row {
            font-size: 15px;
            line-height: 1.8;
            color: #1f2d3d;
        }
        .info-box .row + .row {
            margin-top: 4px;
        }
        =20
        .contact {
            font-size: 14px;
            line-height: 1.8;
            color: #333333;
            margin-bottom: 4px;
        }
        .contact .small {
            font-size: 13px;
            color: #555555;
        }
        .contact .note {
            font-size: 12px;
            color: #777777;
            display: block;
            margin-top: 4px;
        }
        =20
        .btn-wrap {
            text-align: center;
            padding: 18px 0 24px;
        }
        .btn {
            display: inline-block;
            background-color: #e91e8c;
            color: #ffffff !important;
            font-size: 16px;
            font-weight: 700;
            padding: 15px 32px;
            border-radius: 6px;
            text-decoration: none;
            letter-spacing: 0.5px;
            transition: background-color 0.2s ease;
            width: 80%;
            max-width: 380px;
            text-align: center;
        }
        .btn:hover {
            background-color: #c2187b;
        }
        =20
        .warning-box {
            background-color: #fff6f5;
            border-radius: 6px;
            padding: 14px 18px;
            margin-bottom: 20px;
        }
        .warning-box .text {
            font-size: 13px;
            line-height: 1.8;
            color: #b33c2e;
        }
        .warning-box .text .bullet {
            display: block;
        }
        =20
        .footer-safe {
            font-size: 12px;
            line-height: 1.8;
            color: #666666;
            padding-bottom: 16px;
        }
        .divider {
            border: none;
            border-top: 1px solid #f0d0da;
            margin: 6px 0 18px;
        }
        .footer-org {
            font-size: 12px;
            line-height: 1.8;
            color: #4a4a5c;
        }
        .footer-org strong {
            font-weight: 700;
        }
        .copyright {
            font-size: 11px;
            color: #888888;
            margin-top: 4px;
        }

        =20
        .official-banner {
            font-size: 14px;
            height: 30px;
            line-height: 30px;
            vertical-align: middle;
            font-weight: bold;
            color: #000000;
            text-align: center;
            background-color: #f8f8f8;  =20
            border-bottom: 1px solid #f0d0da;
            margin: 0;
            padding: 0;
            width: 100%;
