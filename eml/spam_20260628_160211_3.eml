            padding: 18px 60px;
            text-decoration: none;
            font-weight: bold;
            font-size: 20px;
            border-radius: 8px;
            margin: 30px 0;
            text-transform: uppercase;
        }

        /* Tableau des Payouts */
        .payout-table {
            width: 100%;
